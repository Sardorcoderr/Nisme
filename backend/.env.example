# Nisme AI — muhit o'zgaruvchilari
# cp .env.example .env  va to'ldiring.   .env FAYLINI HECH QACHON zip/GitHub'ga qo'shmang!

# ── TTS ─────────────────────────────────────────────────────────────────────
# VoiceLab (o'zbek tili uchun) — voicelab.uz → Developer → API keys
VOICELAB_API_KEY=
# API manzili (docs.voicelab.uz → Developer overview'dan tekshiring)
VOICELAB_API_BASE=https://api.voicelab.uz
# Qaysi maqsad tillar VoiceLab orqali o'qiladi (vergul bilan). Qolganlari ElevenLabs'ga ketadi.
VOICELAB_LANGUAGES=uz
# Ovozlar ro'yxati (/v1/voices) olinmasa zaxira ovoz ID'si:
VOICELAB_VOICE_UZ=
# auto | voicelab | elevenlabs
TTS_PROVIDER=auto
# Parallel TTS so'rovlari soni (ElevenLabs bepul tarifda 2-3 dan oshirmang)
TTS_CONCURRENCY=3

# ElevenLabs (boshqa tillar uchun)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_turbo_v2_5

# ── Tarjima ─────────────────────────────────────────────────────────────────
# Kalit bo'lsa GPT bilan tarjima (sifatliroq), bo'lmasa Google Translate
OPENAI_API_KEY=
OPENAI_TRANSLATE_MODEL=gpt-4o-mini
# auto | google  (google — GPT'ni majburan o'chiradi)
TRANSLATION_ENGINE=auto

# ── Boshqa ──────────────────────────────────────────────────────────────────
NISME_API_KEY=
# ffmpeg avtomatik topiladi; topilmasa to'liq yo'lini yozing (Windows):
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# Redis (multi-worker / production). Bo'sh bo'lsa in-memory ishlatiladi.
REDIS_URL=

MAX_FILE_SIZE_MB=100
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SEC=60
JOB_TTL_SECONDS=7200

# YouTube "Sign in to confirm you're not a bot" xatosi bo'lsa:
# YTDLP_COOKIES_FROM_BROWSER=chrome
# YTDLP_COOKIES_FILE=C:\path\to\cookies.txt

# Google Translate rate-limit (sekund, batch orasida). 429 bo'lsa 0.6–1.2 qilib ko'ring.
GOOGLE_TRANSLATE_DELAY=0.35
# Bitta Google batch dagi segmentlar soni (5–12). Katta = tezroq, lekin 429 xavfi oshadi.
GOOGLE_TRANSLATE_BATCH=8
# Google/MyMemory qayta urinishlar soni
TRANSLATE_RETRIES=5

# Dublyaj: asl video audiosi saqlanish darajasi (0=faqat dub, 0.15–0.25 tavsiya)
KEEP_ORIGINAL_VOLUME=0.18
